        "Standard_E2s_v5",
        "Standard_E4s_v5",
        "Standard_F2s_v2",
        "Standard_F4s_v2"
      ],
      "enumNames": [
        "B1s (1 vCPU, 1 GiB)",
        "B2s v2 (2 vCPU, 8 GiB)",
        "B2ms (2 vCPU, 8 GiB)",
        "B4s v2 (4 vCPU, 16 GiB)",
        "D2s v5 (2 vCPU, 8 GiB)",
        "D4s v5 (4 vCPU, 16 GiB)",
        "D8s v5 (8 vCPU, 32 GiB)",

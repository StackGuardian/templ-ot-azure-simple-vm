    "vm_size": {
      "type": "string",
      "default": "Standard_B2s_v2",
      "enum": [
        "Standard_B1s",
        "Standard_B2s_v2",
        "Standard_B2ms",
        "Standard_B4s_v2",
        "Standard_D2s_v5",
        "Standard_D4s_v5",
        "Standard_D8s_v5",
        "Standard_D2as_v5",

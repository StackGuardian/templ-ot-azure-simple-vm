        "E4s v5 (4 vCPU, 32 GiB, memory optimized)",
        "F2s v2 (2 vCPU, 4 GiB, compute optimized)",
        "F4s v2 (4 vCPU, 8 GiB, compute optimized)"
      ]
    },
    "advanced_settings": {
      "type": "object",
      "properties": {
        "show_advanced_settings": {
          "type": "boolean",
          "default": false
        }
      },
      "dependencies": {
        "show_advanced_settings": {
          "oneOf": [
            {
              "properties": {
                "show_advanced_settings": {
                  "enum": [
                    false
                  ]
                }
              },
              "required": []
            },
            {
              "properties": {
                "show_advanced_settings": {
                  "enum": [
                    true
                  ]
                },
                "vnet_cidr": {
                  "title": "VNet cidr",
                  "type": "string",
                  "description": "Address space of the VNet",
                  "default": "10.0.0.0/16"
                },
                "admin_username": {
                  "title": "Admin username",
                  "type": "string",
                  "description": "Admin user on the VM",
                  "default": "azureuser"
                },
                "enable_public_ip": {
                  "title": "Enable public ip",
                  "type": "boolean",
                  "description": "Attach a Standard public IP to the VM",
                  "default": false
                },
                "allowed_ingress_cidrs": {
                  "title": "Allowed ingress cidrs",
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "IPv4 CIDRs allowed to reach the VM when the public IP is enabled. Open to everyone by default.",
                  "default": [
                    "0.0.0.0/0"
                  ]
                },
                "allowed_ingress_ports": {
                  "title": "Allowed ingress ports",
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "description": "TCP ports opened for allowed_ingress_cidrs when the public IP is enabled",
                  "default": [
                    22
                  ]
                },
                "encryption_at_host_enabled": {
                  "title": "Encryption at host enabled",
                  "type": "boolean",
                  "description": "Encrypt temp disk and caches on the host. Needs the EncryptionAtHost feature registered in the subscription.",
                  "default": false
                },
                "tags": {
                  "title": "Tags",
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  },
                  "description": "Additional tags for all resources",
                  "default": {}
                }
              },
              "required": []
            }
          ]
        }
      },
      "required": []
    }
  },
  "title": "Azure Virtual Machine (Linux)",
  "dependencies": {}
}
